# Comma-separated exact origins allowed to call this API.
# For local Vite, keep http://localhost:5173.
# Add your deployed QualiBoost origin when you deploy the frontend.
QUALIBOOST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUALIBOOST_MAX_UPLOAD_MB=15
QUALIBOOST_PROCESS_TIMEOUT_SECONDS=600
